{
  "name": "feemargin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "generate:seo": "node scripts/generate-seo-pages.mjs",
    "prebuild": "node scripts/generate-seo-pages.mjs --data-only",
    "build": "vite build && node scripts/generate-seo-pages.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "tsx --test scripts/math.test.ts scripts/quote-url.test.ts",
    "audit:build": "node scripts/audit-build.mjs",
    "release": "npm run check && npm test && npm run build && npm run audit:build"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "vite": "^7.0.0",
    "typescript": "^5.7.0",
    "tsx": "^4.19.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "vite-plugin-sitemap": "^0.8.1"
  }
}
